# Secrets — never commit (D-09/D-10: SSM is the source of truth)
.env

# Run artifacts (rendered audio, per-run JSON) — committed A/B verdicts live in docs/tuning/
artifacts/

# Per-scenario eval run logs (transient; the diffable record is docs/tuning/*.json)
*.eval.log

# Python
.venv/
__pycache__/
*.pyc

# Client (Vite+TS+React SPA) — D-03: no committed build artifacts; the
# multi-stage Docker build runs `npm ci && npm run build` and COPYs dist/
# into the image. node_modules is always reinstalled from package-lock.json.
client/node_modules/
client/dist/
client/*.tsbuildinfo

# RICK phone-game audio (quick 260729-rck): clips live in PRIVATE S3
# (s3://$KMV_LEDGER_BUCKET/media/telephony/rick/, synced at boot by
# telephony/audio_sync.py) -- never commit audio to this public repo.
assets/telephony/rick/*.wav
assets/telephony/rick-src/*
!assets/telephony/rick-src/README.md
