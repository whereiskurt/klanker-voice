# --- secrets: NEVER track plaintext secret material (public repo, D-07) ---
apps/*/.env
infra/terraform/live/site/.secrets.json
env.local.sh

# --- terraform / terragrunt runtime state ---
.terragrunt-cache/
.terraform/
*.tfstate
*.tfstate.backup

# --- run artifacts (rendered audio, per-run JSON) — committed A/B verdicts live in docs/tuning/ ---
apps/voice/artifacts/

# --- Python ---
.venv/
__pycache__/
*.pyc

# --- tool runtime / generated caches ---
.claude/worktrees/
.planning/research/.cache/
.DS_Store

# Phase 7: source audio for transcription lives outside the repo (large binaries)
apps/voice/knowledge/transcripts/incoming/

# kv CLI: locally-built operator binary (see kv/Makefile `build`)
kv/bin/

# Phase 16: `kv backup`/`kv restore` artifacts (D-14) — these zips hold
# unencrypted transcripts and user email addresses (D-08) and must never be
# committed, no matter which --out directory an operator points at the
# repo-root default.
backups/

temp/

kv/bin/kv
# Editor workspace settings (local only)
.vscode/

# Stray root-level kv binary from `go build ./cmd/kv` without -o.
# Anchored with a leading slash: a bare `kv` line here once ignored the
# entire kv/ source tree for three days (see quick 260806-cm9).
/kv/kv
